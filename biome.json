{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!reports",
      "!pnpm-lock.yaml",
      "!.changeset/**/*.md",
      "!.secrets",
      "!.snowflake",
      "!website/dist",
      "!website/.astro",
      "!website/src/content/docs/api"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["website/**/*.astro", "website/src/snippets/**"],
      "linter": {
        "rules": { "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
