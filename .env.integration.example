# Copy your client account identifier (organization-account) from Snowflake account details.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=SNOWFLAKE_TYPESAFE_TEST_USER
SNOWFLAKE_DATABASE=SNOWFLAKE_TYPESAFE_TEST_DB
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_TYPESAFE_TEST_WH
SNOWFLAKE_ROLE=SNOWFLAKE_TYPESAFE_TEST_ROLE
# Set a key file path OR provide the Base64-encoded full PEM in SNOWFLAKE_PRIVATE_KEY.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_test_key.p8
# Direct keys take precedence over the path. Base64 keeps the value on one line:
# SNOWFLAKE_PRIVATE_KEY=<base64 of the entire PEM, including header and footer>
# Raw PEM in a quoted multiline value is also accepted.
# Optional, only if you replace the generated key with an encrypted PKCS#8 key:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
